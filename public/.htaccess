# Force HTTPS (optionnel, décommenter si besoin)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ne pas rediriger les fichiers existants
  RewriteCond %{REQUEST_FILENAME} !-f
  # Ne pas rediriger les dossiers existants
  RewriteCond %{REQUEST_FILENAME} !-d

  # Fallback SPA : toutes les autres requêtes vont vers index.html
  RewriteRule ^(.*)$ /index.html [L]
</IfModule>

# Fallback si mod_rewrite n'est pas disponible
ErrorDocument 404 /index.html
