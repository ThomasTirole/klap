DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Définir la base - IMPORTANT pour Infomaniak
  RewriteBase /

  # Si c'est un fichier réel, le servir
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Sinon, servir index.html SANS redirection (PT = passthrough)
  RewriteRule ^ index.html [L,PT]
</IfModule>

# Fallback alternatif
<IfModule !mod_rewrite.c>
  FallbackResource /index.html
</IfModule>
